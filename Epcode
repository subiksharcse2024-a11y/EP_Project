/************ RC522 ************/
#define SS_PIN   5
#define RST_PIN  22

MFRC522 rfid(SS_PIN, RST_PIN);

/************ Servo ************/
#define SERVO_PIN 4

Servo lockServo;

/************ Keypad ************/
const byte ROWS = 4;
const byte COLS = 4;

char keys[ROWS][COLS] =
{
  {'1','2','3','A'},
  {'4','5','6','B'},
  {'7','8','9','C'},
  {'*','0','#','D'}
};

byte rowPins[ROWS] = {13,12,14,27};
byte colPins[COLS] = {26,25,33,32};

Keypad keypad = Keypad(
  makeKeymap(keys),
  rowPins,
  colPins,
  ROWS,
  COLS
);

/************ Password ************/
String normalPIN = "1234";
String duressPIN = "9999";
String enteredPIN = "";

/************ RFID UID ************/
byte authorizedUID[4] =
{
  0x13,
  0x25,
  0x6F,
  0x05
};

/************ Security ************/
int wrongAttempts = 0;

bool systemLocked = false;

unsigned long lockStart = 0;

const unsigned long lockDuration = 30000;

/************ Servo Timer ************/
bool lockerOpen = false;

unsigned long servoTimer = 0;

const unsigned long autoCloseTime = 5000;

void setup()
{
  Serial.begin(115200);

  SPI.begin();

  rfid.PCD_Init();

  lockServo.setPeriodHertz(50);
  lockServo.attach(SERVO_PIN);
  lockServo.write(0);

  WiFi.begin(ssid, password);

  Serial.print("Connecting");

  while (WiFi.status() != WL_CONNECTED)
  {
    Serial.print(".");
    delay(500);
  }

  client.setInsecure();

  Serial.println();
  Serial.println("WiFi Connected");

  bot.sendMessage(CHAT_ID,
                  "Smart Locker Started",
                  "");

  Serial.println("System Ready");
}
/*************************************************
                MODULE 2
*************************************************/

//-------------------- Servo --------------------

void openLocker( )
{
  Serial.println("Opening Servo...");
  lockServo.write(90);

  lockerOpen = true;

  servoTimer = millis();

  Serial.println("Locker Opened");
}

void closeLocker()
{
  Serial.println("Closing Servo...");
  lockServo.write(0);

  lockerOpen = false;

  Serial.println("Locker Closed");
}

//---------------- RFID Authentication ----------------

bool checkRFID()
{
  if (!rfid.PICC_IsNewCardPresent())
    return false;

  if (!rfid.PICC_ReadCardSerial())
    return false;

  Serial.print("Card UID : ");

  for (byte i = 0; i < rfid.uid.size; i++)
  {
    Serial.print(rfid.uid.uidByte[i], HEX);
    Serial.print(" ");
  }

  Serial.println();

  bool authorized = true;

  for (byte i = 0; i < 4; i++)
  {
    if (rfid.uid.uidByte[i] != authorizedUID[i])
    {
      authorized = false;
      break;
    }
  }

  if (authorized)
  {
    Serial.println("Authorized RFID");

    wrongAttempts = 0;

    openLocker();
  }
  else
  {
    Serial.println("Unauthorized RFID");

    wrongAttempts++;

    if (wrongAttempts >= 3)
    {
      systemLocked = true;

      lockStart = millis();

      bot.sendMessage(
        CHAT_ID,
        "⚠️ 3 Unauthorized RFID Attempts!\nLocker Locked for 30 Seconds.",
        ""
      );
    }
  }

  rfid.PICC_HaltA();
  rfid.PCD_StopCrypto1();

  return authorized;
}
