                MODULE 3
*************************************************/

//--------------- PASSWORD CHECK ----------------

void checkPassword()
{
  if (enteredPIN == normalPIN)
  {
    Serial.println("Correct PIN");

    wrongAttempts = 0;

    openLocker();
  }

  else if (enteredPIN == duressPIN)
  {
    Serial.println("Duress PIN Accepted");

    wrongAttempts = 0;

    openLocker();

    bot.sendMessage(
      CHAT_ID,
      "🚨 EMERGENCY ALERT!\nDuress PIN Entered.\nLocker Opened.",
      ""
    );
  }

  else
  {
    Serial.println("Wrong PIN");

    wrongAttempts++;

    Serial.print("Attempts : ");
    Serial.println(wrongAttempts);

    if (wrongAttempts >= 3)
    {
      systemLocked = true;

      lockStart = millis();

      Serial.println("System Locked");

      bot.sendMessage(
        CHAT_ID,
        "⚠️ 3 Wrong Password Attempts!\nLocker Locked for 30 Seconds.",
        ""
      );
    }
  }

  enteredPIN = "";
}

//--------------- RESET LOCK ----------------

void resetLock()
{
  if (systemLocked)
  {
    if (millis() - lockStart >= lockDuration)
    {
      systemLocked = false;

      wrongAttempts = 0;

      Serial.println("System Unlocked");
    }
  }
}

//--------------- AUTO CLOSE ----------------

void autoCloseServo()
{
  if (lockerOpen)
  {
    if (millis() - servoTimer >= autoCloseTime)
    {
      closeLocker();
    }
  }
}
/*************************************************
                MODULE 4
*************************************************/

void loop()
{
  // Reset lock after 30 seconds
  resetLock();

  // If system is locked, don't allow input
  if (systemLocked)
  {
    return;
  }

  // Auto close servo after 5 seconds
  autoCloseServo();

  // Check RFID card
  checkRFID();

  // Read keypad
  char key = keypad.getKey();

  if (key)
  {
    Serial.print(key);

    if (key == '*')
    {
      enteredPIN = "";
      Serial.println("\nPIN Cleared");
    }
    else if (key == '#')
    {
      Serial.println();
      checkPassword();
    }
    else
    {
      if (enteredPIN.length() < 4)
      {
        enteredPIN += key;
      }
    }
  }
}